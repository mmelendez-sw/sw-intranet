{
    "name": "intranet-site",
    "version": "1.0.0",
    "description": "A company intranet site built with React and TypeScript.",
    "private": true,
    "scripts": {
        "start": "webpack serve --open --mode development",
        "build": "webpack --mode production",
        "check:dark": "node scripts/check-dark-theme.js",
        "build:tv-api": "tsc -p server/tsconfig.json",
        "tv-api": "npm run build:tv-api && node -r ./server/loadEnv.js server/dist/localDev.js",
        "api": "npm run tv-api",
        "deploy:lambda": "powershell -ExecutionPolicy Bypass -File scripts/deploy-lambda.ps1 -FunctionName sw-intranet-api -Region us-east-2",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server && tsc --noEmit -p server/tsconfig.test.json"
    },
    "dependencies": {
        "@azure/msal-browser": "^3.27.0",
        "@azure/msal-react": "^2.2.0",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@microsoft/microsoft-graph-client": "^3.0.7",
        "@tiptap/core": "3.31.4",
        "@tiptap/pm": "3.31.4",
        "@tiptap/react": "3.31.4",
        "@tiptap/starter-kit": "3.31.4",
        "busboy": "^1.6.0",
        "dompurify": "3.4.16",
        "exceljs": "^4.4.0",
        "exifr": "^7.1.3",
        "jimp": "^0.22.12",
        "powerbi-client": "^2.24.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.28.0",
        "serverless-http": "^4.0.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/busboy": "^1.5.4",
        "@types/node": "^26.1.2",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "copy-webpack-plugin": "^13.0.0",
        "css-loader": "^6.8.1",
        "esbuild": "^0.28.2",
        "html-webpack-plugin": "^5.5.3",
        "jsdom": "^26.1.0",
        "mini-css-extract-plugin": "^2.10.2",
        "style-loader": "^3.3.3",
        "ts-loader": "^9.4.4",
        "typescript": "^5.1.3",
        "vitest": "^3.2.7",
        "webpack": "^5.88.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.0"
    }
}
