# Copy to server/.env for local `npm run api`. Never commit .env.
# Set the same names on the Lambda (Configuration → Environment variables).

# --- Microsoft Graph ROPC (SharePoint TV cards) ---
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-public-client-app-id
MICROSOFT_USERNAME=automation-user@yourdomain.com
MICROSOFT_PASSWORD=use-a-secret-store-not-git

# Public origin of this API (no trailing slash).
# Local default is http://localhost:3001 if unset.
# On Lambda: set to your Function URL after creating it.
TV_API_PUBLIC_BASE=http://localhost:3001

# Optional overrides (defaults match Symphony intranet cards file)
# TV_SHAREPOINT_DRIVE_ID=
# TV_HOMEPAGE_CARDS_ITEM_ID=
# DEFAULT_IMAGES_FOLDER_PATH=General/intranet/Default Images

API_PORT=3001
