# Store text files with LF and check them out as LF on every OS, regardless of
# each machine's core.autocrlf setting (avoids "LF will be replaced by CRLF" warnings).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.zip binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
